{
  "version": "1.0.0",
  "cohortSize": 1000,
  "maps": {
    "accountStatus": { "OPEN": "Active", "CLOSED": "Closed", "DORMANT": "Dormant", "FROZEN": "Frozen" },
    "transactionStatus": { "POSTED": "Posted", "PENDING": "Pending" },
    "holderRole": { "PRIMARY": "Primary", "JOINT": "Joint" },
    "product": {
      "EVR00": "TXN-CLASSIC", "EVR01": "TXN-EVERYDAY", "EVR02": "TXN-SENIORS", "OFF01": "TXN-OFFSET",
      "SAV00": "SAV-PASSBOOK", "SAV01": "SAV-ONLINE", "SAV02": "SAV-BONUS", "TDP": "TD-FIXED",
      "HLV": "HL-VARIABLE", "HLF": "HL-FIXED", "PLN": "PL-STANDARD", "CCS": "CC-LOWRATE", "CCR": "CC-REWARDS"
    }
  },
  "tables": {
    "customers": [
      { "to": "customer_id", "from": "CUST_ID" },
      { "to": "title", "from": "TITLE", "rule": "name" },
      { "to": "first_name", "from": "FIRST_NAME", "rule": "name" },
      { "to": "middle_name", "from": "MIDDLE_NAME", "rule": "name" },
      { "to": "last_name", "from": "LAST_NAME", "rule": "name" },
      { "to": "gender", "from": "GENDER" },
      { "to": "date_of_birth", "from": "DATE_OF_BIRTH", "rule": "date" },
      { "to": "address_line", "from": "ADDRESS_LINE", "rule": "text" },
      { "to": "suburb", "from": "SUBURB", "rule": "text" },
      { "to": "state", "from": "STATE" },
      { "to": "postcode", "from": "POSTCODE" },
      { "to": "mobile", "from": "MOBILE", "rule": "mobile" },
      { "to": "email", "from": "EMAIL", "rule": "text" },
      { "to": "preferred_contact", "from": "PREFERRED_CONTACT" },
      { "to": "customer_since", "from": "CUSTOMER_SINCE", "rule": "date" },
      { "to": "home_branch", "from": "HOME_BRANCH" },
      { "to": "employment_status", "from": "EMPLOYMENT_STATUS" },
      { "to": "occupation", "from": "OCCUPATION", "rule": "text" },
      { "to": "employer", "from": "EMPLOYER", "rule": "text" },
      { "to": "annual_income", "from": "ANNUAL_INCOME" },
      { "to": "residential_status", "from": "RESIDENTIAL_STATUS" },
      { "to": "marital_status", "from": "MARITAL_STATUS" },
      { "to": "dependants", "from": "DEPENDANTS" },
      { "to": "tfn_status", "from": "TFN_STATUS" },
      { "to": "tax_residency", "from": "TAX_RESIDENCY" },
      { "to": "kyc_status", "from": "KYC_STATUS" },
      { "to": "kyc_id_type", "from": "KYC_ID_TYPE", "rule": "text" },
      { "to": "kyc_verified_on", "from": "KYC_VERIFIED_DATE", "rule": "date" },
      { "to": "aml_risk_rating", "from": "AML_RISK_RATING" },
      { "to": "is_pep", "from": "PEP", "rule": "flag" },
      { "to": "credit_score", "from": "CREDIT_SCORE" },
      { "to": "credit_score_on", "from": "CREDIT_SCORE_DATE", "rule": "date" },
      { "to": "credit_enquiries_5y", "from": "CREDIT_ENQUIRIES5Y" },
      { "to": "credit_defaults", "from": "CREDIT_DEFAULTS" },
      { "to": "is_bankrupt", "from": "BANKRUPT", "rule": "flag" },
      { "to": "is_vulnerable", "from": "VULNERABLE", "rule": "flag" },
      { "to": "is_deceased", "from": "DECEASED", "rule": "flag" },
      { "to": "marketing_consent", "from": "MARKETING_CONSENT", "rule": "flag" }
    ],
    "accounts": [
      { "to": "account_number", "from": "ACCT_NO" },
      { "to": "bsb", "from": "BSB", "rule": "bsb" },
      { "to": "product_code", "from": "PRODUCT_CODE", "rule": "map:product" },
      { "to": "product_name", "from": "PRODUCT_NAME", "rule": "text" },
      { "to": "account_name", "from": "ACCOUNT_NAME", "rule": "text" },
      { "to": "branch", "from": "BRANCH" },
      { "to": "opened_on", "from": "OPEN_DATE", "rule": "date" },
      { "to": "closed_on", "from": "CLOSE_DATE", "rule": "date" },
      { "to": "status", "from": "STATUS", "rule": "map:accountStatus" },
      { "to": "balance", "from": "BALANCE" },
      { "to": "available_balance", "from": "AVAILABLE_BALANCE" },
      { "to": "interest_rate", "from": "INTEREST_RATE" },
      { "to": "accrued_interest", "from": "ACCRUED_INTEREST" },
      { "to": "last_interest_on", "from": "LAST_INTEREST_DATE", "rule": "date" },
      { "to": "overdraft_limit", "from": "OVERDRAFT_LIMIT" },
      { "to": "credit_limit", "from": "CREDIT_LIMIT" },
      { "to": "masked_card_no", "from": "MASKED_CARD_NO", "rule": "text" },
      { "to": "original_amount", "from": "ORIGINAL_AMOUNT" },
      { "to": "term_months", "from": "TERM_MONTHS" },
      { "to": "maturity_on", "from": "MATURITY_DATE", "rule": "date" },
      { "to": "maturity_instruction", "from": "MATURITY_INSTRUCTION", "rule": "text" },
      { "to": "repayment_amount", "from": "REPAYMENT_AMOUNT" },
      { "to": "repayment_frequency", "from": "REPAYMENT_FREQUENCY", "rule": "text" },
      { "to": "repayment_type", "from": "REPAYMENT_TYPE", "rule": "text" },
      { "to": "next_due_on", "from": "NEXT_DUE_DATE", "rule": "date" },
      { "to": "arrears_days", "from": "ARREARS_DAYS" },
      { "to": "arrears_amount", "from": "ARREARS_AMOUNT" },
      { "to": "repayment_history", "from": "REPAYMENT_HISTORY24M", "rule": "text" },
      { "to": "in_hardship", "from": "HARDSHIP", "rule": "flag" },
      { "to": "loan_purpose", "from": "LOAN_PURPOSE", "rule": "text" },
      { "to": "security_value", "from": "SECURITY_VALUE" },
      { "to": "original_lvr", "from": "ORIGINAL_LVR" },
      { "to": "fixed_rate_expiry", "from": "FIXED_RATE_EXPIRY", "rule": "date" },
      { "to": "linked_account_number", "from": "LINKED_ACCT_NO", "rule": "text" },
      { "to": "last_activity_on", "from": "LAST_ACTIVITY_DATE", "rule": "date" }
    ],
    "account_holders": [
      { "to": "account_number", "from": "ACCT_NO" },
      { "to": "customer_id", "from": "CUST_ID" },
      { "to": "role", "from": "ROLE", "rule": "map:holderRole" }
    ],
    "transactions": [
      { "to": "transaction_id", "from": "TXN_ID" },
      { "to": "account_number", "from": "ACCT_NO" },
      { "to": "transaction_date", "from": "TXN_DATE", "rule": "date" },
      { "to": "posted_on", "from": "POST_DATE", "rule": "date" },
      { "to": "code", "from": "TXN_CODE" },
      { "to": "description", "from": "DESCRIPTION", "rule": "text" },
      { "to": "amount", "from": "AMOUNT" },
      { "to": "running_balance", "from": "RUNNING_BALANCE" },
      { "to": "status", "from": "STATUS", "rule": "map:transactionStatus" },
      { "to": "channel", "from": "CHANNEL" }
    ]
  }
}
